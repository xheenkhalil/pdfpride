# Environment Configuration for PDF Pride (Document Studio)

# Environment Mode
ENVIRONMENT=development
DEBUG=True

# Backend Server (FastAPI)
PORT=8000
SECRET_KEY=replace_with_a_secure_random_secret_in_production
API_V1_STR=/api/v1

# Database Configuration (PostgreSQL 16)
POSTGRES_USER=pdfpride
POSTGRES_PASSWORD=pdfpride_secret
POSTGRES_DB=pdfpride_db
DATABASE_URL=postgresql+asyncpg://pdfpride:pdfpride_secret@localhost:5432/pdfpride_db

# Redis Message Broker & State Store
REDIS_URL=redis://localhost:6379/0

# File Storage Configuration
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage_data

# Optional: AWS S3 / Cloudflare R2 Credentials (for production)
# S3_BUCKET_NAME=pdfpride-storage
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT_URL=
# S3_REGION=auto

# Frontend Client (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
